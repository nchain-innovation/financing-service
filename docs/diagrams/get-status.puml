@startuml
title Get Status
hide footbox
actor Admin as C
box "System" #lightblue

    participant FinancingService as FS
    participant BlockchainInterface as BS
end box

Collections Blockchain


C -> FS: get_status()
activate FS
FS -> FS: read blockchain_status\n(recorded by the periodic refresh)

FS --> C: response\n{version, blockchain_status, blockchain_update_time, broadcaster}
deactivate FS

@enduml