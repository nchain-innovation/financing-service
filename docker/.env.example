# Example docker/.env. Copy to docker/.env (gitignored) if you need any of it.
#
# This file is entirely OPTIONAL. Everything the financing service itself reads
# lives in data/financing-service.toml, which is bind-mounted into the container.
# Only the settings below are consumed by Docker rather than by the service, plus
# secrets, which are deliberately kept out of the config file.

# ---------------------------------------------------------------------------
# Docker-level settings (cannot live in the TOML -- Compose cannot read it)
# ---------------------------------------------------------------------------

# Host port for the financing service REST API. The container port comes from
# [web_interface] port in the TOML and must match the image's HEALTHCHECK, so
# only the host side is adjustable here.
#
# Defaults to 8080. Set it to 8081 when running alongside wild-bit-lab, whose
# block explorer occupies host 8080.
#FS_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Local WhatsOnChain stack (`--profile woc`)
# ---------------------------------------------------------------------------
# Only read when the `woc` profile is active. The stack indexes an existing BSV
# node; it does not run one.

# Host port for the local WoC API. The container port is fixed at 8084 by the
# image, so only the host side is adjustable. From another container in this
# stack the API is reachable as http://woc-api:8084 regardless of this value.
#WOC_API_PORT=5010

# The BSV node the stack indexes. The default reaches a node running on the
# Docker host (via host-gateway); set it to a container name such as `node1` if
# the node runs in a Docker network this stack is attached to.
#WOC_BSV_HOST=host.docker.internal
#WOC_BSV_PORT=18332
#WOC_BSV_ZMQ_PORT=28332
#WOC_BSV_PASSWORD=bitcoin

# Name of the network wild-bit-lab creates. Only read by the wild-bit-lab
# overlay (docker/woc/docker-compose.wbl.yml); change it only if you have
# altered wild-bit-lab's compose files.
#WBL_NETWORK=regtest_network

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Referenced from data/financing-service.toml as `env:VAR_NAME`, or used to
# override config values directly. See ../docs/Configuration.md. These stay in
# the environment by design -- the service warns if secrets are inlined in the
# config file.
#
# Client variables are named from the client_id, uppercased with
# non-alphanumerics replaced by underscores: client_id = "id1" -> FS_CLIENT_ID1_*

#FS_ADMIN_API_KEY=
#FS_CLIENT_ID1_WIF=
#FS_CLIENT_ID1_API_KEY=

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------
# Standard OTEL variables are honoured, but [telemetry] in the TOML is the
# primary place to configure this (enabled, service_name, otlp_endpoint).

#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317
